import { Logic, Color, Enabled} from "logic.slint";
import { Button, Slider } from "std-widgets.slint";


export component Settings  inherits Rectangle{
    z: 5;
    width: 720px;
    height: 480px;

    opacity: Enabled.all_settings_button ? 1.0 : 0.0;
    animate opacity {duration: 200ms; easing: ease-in-out;}
    Rectangle {
        width: 1005px;
        height: 563px;
        background: Color.background;
        opacity: 0.75;
    }
    Rectangle {
        background: Color.background;
        border-radius: 20px;
        border-color: Color.primary;
        border-width: 0.5px;
    }

    Rectangle {
        x: parent.width - self.width - 30px;
        y: 30px;
        width: 20px;
        height: 20px;
        clip: true;
        TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: Enabled.all_settings_button;
            clicked => {
                Enabled.all_settings_button = false;
                Enabled.global_button = true;
                debug("settings exit")
            }
            Image {
                source: @image-url("image/exit.png");
                width: 100%;
                height: 100%;
            }
        }
    }
    Rectangle {
        z:5;
        Text {
             x:parent.width - self.width - 75px;
             y: 410px;
             text: "Сохранить";
        }
        Text {
            x: 415px;
            y:100px;
            color: Color.primary;
            text: "Выделение памяти: \{Logic.mamory} ГБ";
        }
    }

    Rectangle {
        x:parent.width - self.width - 30px;
        y: 80px;
        width: 300px;
        height: 100px;
        border-radius: 16px;
        border-color: Color.qwer;
        border-width: 0.5px;
        background: Color.background;

    }





    Slider {
        x:414px;
        y: 125px;
        width: 255px;
        height: 50px;
        minimum: 2;
        maximum: 16;
        value: Logic.mamory;


        changed(value) => {
            Logic.mamory = round(value)
        }
    }

    Rectangle {
        x:parent.width - self.width - 40px;
        y:400px;
        width: 150px;
        height: 40px;
        background: Color.primary;
        border-radius: 20px;
        clip: true;

        Button {
            width: 100%;
            height: 100%;
            enabled: Enabled.all_settings_button;
            clicked => {
                //Logic.login_information_output = "";
                Logic.settings_save();
                Enabled.all_settings_button = false;
                Enabled.global_button = true;
                debug("sssss")
            }
        }
    }
}





