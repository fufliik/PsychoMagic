export global Logic {
    //rust переменные
    //добавил в логику
    in-out property <string> button_play_status;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <int> mamory;
    in-out property <string> login_information_output;
    in-out property <string> console_log;
    in-out property <string> progress_bar;
    in-out property <string> status_bar: "Загрузка файлов игры";
    in-out property <string > server_online;

    //callback
    callback play_minecrat_process;
    callback auth_save;
    callback settings_save;
}

export global Color {
    //rust переменные
    in-out property <color> button_play;

    //slint переменные
    in-out property <color> background: #151515;
    in-out property <color> black: #0B0A0A;
    in-out property <color> primary: #008E45;
    in-out property <color> red: #FF6363;
    in-out property <color> qwer: #969696;
}

export global Enabled {
    //rust переменные
    in-out property <bool> global_button: true;
    in-out property <bool> button_play: true;

    //slint переменные
    in-out property <bool> all_settings_button;
    in-out property <bool> all_auth_button;

    in-out property <bool> hotbar: false; // false

}